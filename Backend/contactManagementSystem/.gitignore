# ==============================
# Secrets and environment files
# ==============================
.env
.env.*
!.env.example

**/application-local.properties
**/application-secrets.properties
**/application-production-local.properties

# Keep application.properties and application-production.properties
# only if they contain environment-variable placeholders, not real secrets.

# ==============================
# Java / Maven
# ==============================
**/target/
**/build/
**/out/
*.class
*.jar
*.war
hs_err_pid*

# Maven wrapper JAR can be committed if the project uses it.
# Do not ignore .mvn/wrapper/maven-wrapper.jar by default.

# ==============================
# IDEs
# ==============================
.idea/
.vscode/
*.iml
*.ipr
*.iws

# ==============================
# Operating system
# ==============================
.DS_Store
Thumbs.db
Desktop.ini

# ==============================
# Logs
# ==============================
*.log
logs/

# ==============================
# Node.js / frontend
# ==============================
**/node_modules/
**/.next/
**/dist/
**/coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
.venv/
venv/
.python-version

# ==============================
# Temporary files
# ==============================
*.tmp
*.bak
*.swp
*.swo
